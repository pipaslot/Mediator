@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavigationManager

<Notifications/>
<div class="page">
    <div class="sidebar">
        <NavMenu/>
    </div>

    <div class="main">
        <MediatorSpinner/>
        <div class="top-row px-4">
            <a href="https://github.com/pipaslot/Mediator/wiki" target="_blank" class="ml-md-auto">Wiki</a>
        </div>

        <div class="content px-4">
            <ErrorBoundary @ref="_errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent Context="exception">
                    <div class="alert alert-danger" role="alert">
                        <h4 class="alert-heading">An unexpected error occurred</h4>
                        <p class="mb-2">@exception.Message</p>
                        <button class="btn btn-outline-danger btn-sm" @onclick="Recover">Try again</button>
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </div>
    </div>
</div>

@code {
    private ErrorBoundary? _errorBoundary;

    protected override void OnInitialized()
    {
        // Reset the boundary on navigation, otherwise the error content would
        // stay visible even after the user navigates away to a working page.
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        Recover();
    }

    private void Recover()
    {
        _errorBoundary?.Recover();
    }

}