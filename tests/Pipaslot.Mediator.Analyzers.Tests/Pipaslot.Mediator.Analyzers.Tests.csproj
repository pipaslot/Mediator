<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <!-- Pin to the same Microsoft.CodeAnalysis version the analyzer project builds against - the testing package
             otherwise pulls in an old floor version, see the "Resolve version conflicts" note in
             https://github.com/dotnet/roslyn-sdk/tree/main/src/Microsoft.CodeAnalysis.Testing#readme -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="$(MicrosoftNETTestSdkVersion)"/>
        <PackageReference Include="xunit" Version="$(XunitVersion)"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="$(XunitRunnerVisualStudioVersion)">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="coverlet.collector" Version="$(CoverletCollectorVersion)">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Pipaslot.Mediator.Analyzers\Pipaslot.Mediator.Analyzers.csproj"/>
        <!-- Pinned to net8.0 so the referenced assembly's corelib version matches ReferenceAssemblies.Net.Net80
             used by the analyzer test sources below - the default net10.0 build would reference a newer
             System.Runtime than those reference assemblies provide, and csc rejects that (CS1705). -->
        <ProjectReference Include="..\..\Pipaslot.Mediator\Pipaslot.Mediator.csproj" SetTargetFramework="TargetFramework=net8.0"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

</Project>
